# Tenant Bearer for https://api.kingminos.com (value omitted on purpose).
# Local Node fallback only, and only when bound to loopback AND
# KINGMINOS_MCP_ALLOW_ENV_BEARER=1. Clients should send Authorization: Bearer.
# Worker mode never reads this. Do not put this in wrangler.jsonc, .dev.vars
# committed to git, or Worker secrets.
KINGMINOS_API_KEY=

# Optional. Must be 1 to enable the local loopback env-bearer fallback.
# KINGMINOS_MCP_ALLOW_ENV_BEARER=1

# Optional. Defaults to https://api.kingminos.com
# KINGMINOS_API_URL=

# Optional. Local Node listen address. Defaults to 127.0.0.1
# HOST=127.0.0.1

# Optional. Local Node listen port. Defaults to 8080
# PORT=

# Optional Host allowlist for POST /mcp (comma-separated).
# Node default is localhost,127.0.0.1,[::1]. Worker empty = allow all.
# Production Host: mcp.kingminos.com (see wrangler.jsonc custom_domain route)
# KINGMINOS_MCP_ALLOWED_HOSTS=

# Optional extra Origin hostnames for POST /mcp (comma-separated).
# A present Origin that is not allowlisted is rejected. Missing Origin is allowed.
# KINGMINOS_MCP_ALLOWED_ORIGINS=

# Optional public MCP URL advertised on the server card.
# Worker production default is https://mcp.kingminos.com/mcp
# KINGMINOS_MCP_PUBLIC_URL=

# Optional. Deterministic inventory path for check:surfaces / PR CI.
# KINGMINOS_OPENAPI_INVENTORY=inventory/openapi-surfaces.json

# Optional. Live OpenAPI URL for check:surfaces:live (default https://api.kingminos.com/openapi.json).
# KINGMINOS_OPENAPI_JSON_URL=

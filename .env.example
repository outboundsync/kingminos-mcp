# Tenant Bearer for https://api.kingminos.com (value omitted on purpose).
KINGMINOS_API_KEY=

# Optional. Defaults to https://api.kingminos.com
# KINGMINOS_API_URL=

# Optional. Defaults to 8080
# PORT=

# Optional production Host allowlist (comma-separated). Empty = allow all.
# KINGMINOS_MCP_ALLOWED_HOSTS=

# Optional public MCP URL advertised on the server card.
# KINGMINOS_MCP_PUBLIC_URL=

# Tenant Bearer for https://api.kingminos.com (value omitted on purpose).
# Local Node fallback only. Clients send Authorization: Bearer.
# Do not put this in wrangler.jsonc, .dev.vars committed to git, or Worker secrets.
KINGMINOS_API_KEY=

# Optional. Defaults to https://api.kingminos.com
# KINGMINOS_API_URL=

# Optional. Local Node listen port. Defaults to 8080
# PORT=

# Optional Host allowlist for POST /mcp (comma-separated). Empty = allow all.
# After mcp.kingminos.com is attached: mcp.kingminos.com
# KINGMINOS_MCP_ALLOWED_HOSTS=

# Optional public MCP URL advertised on the server card.
# Worker production default is https://mcp.kingminos.com/mcp (DNS not attached yet).
# KINGMINOS_MCP_PUBLIC_URL=

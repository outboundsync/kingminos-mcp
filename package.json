{
  "name": "kingminos-mcp",
  "version": "2026.10.03.0",
  "private": true,
  "description": "KingMinos by OutboundSync — Streamable HTTP MCP over the live enrichment API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:surfaces": "tsx src/check-surfaces.ts",
    "check:surfaces:live": "tsx src/check-surfaces.ts --live",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx --test src/*.test.ts",
    "check:worker": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --include-runtime false --strict-vars false",
    "deploy": "wrangler deploy",
    "ci": "npm run typecheck && npm run lint && npm run check:surfaces && npm test && npm run smoke && npm run build && npm run check:worker"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}

{
  "name": "kingminos-mcp",
  "version": "2026.10.03.0",
  "private": true,
  "description": "KingMinos by OutboundSync — Streamable HTTP MCP over the live enrichment API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:surfaces": "tsx src/check-surfaces.ts",
    "check:surfaces:live": "tsx src/check-surfaces.ts --live",
    "check:providers": "tsx src/check-providers.ts",
    "check:providers:live": "tsx src/check-providers.ts --live",
    "inventory:refresh": "tsx src/check-surfaces.ts --refresh",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx --test src/*.test.ts && node --test test/**/*.test.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --include-runtime false --strict-vars false",
    "deploy": "wrangler deploy --var GIT_SHA:${WORKERS_CI_COMMIT_SHA:-}",
    "release:preview": "node scripts/release-calver.mjs --dry-run",
    "release:apply": "node scripts/release-calver.mjs --apply --stamp-version",
    "ci": "npm run typecheck && npm run lint && npm run check:surfaces && npm run check:providers && npm test && npm run smoke && npm run build && npm run check:worker",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sentry/cloudflare": "11.8.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install biome check --write --staged --no-errors-on-unmatched && git update-index --again",
    "pre-push": "npm run -s typecheck && npm test"
  }
}

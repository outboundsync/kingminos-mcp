{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingminos-mcp-prod",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // mcp.kingminos.com is the documented public hostname. Do not add a
  // custom_domain / zone route here — Janus wrangler-deploys this Worker;
  // DNS attach for mcp.kingminos.com is a separate zone step.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "KINGMINOS_API_URL": "https://api.kingminos.com",
    "KINGMINOS_MCP_PUBLIC_URL": "https://mcp.kingminos.com/mcp"
  }
}

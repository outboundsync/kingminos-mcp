{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingminos-mcp-prod",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Public MCP URL: https://mcp.kingminos.com/mcp — keep this custom domain in
  // wrangler so Janus deploys retain the hostname already attached in Cloudflare.
  "routes": [
    {
      "pattern": "mcp.kingminos.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "KINGMINOS_API_URL": "https://api.kingminos.com",
    "KINGMINOS_MCP_PUBLIC_URL": "https://mcp.kingminos.com/mcp"
  }
}

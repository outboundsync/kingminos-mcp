{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingminos-mcp-prod",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Public MCP URL: https://mcp.kingminos.com/mcp — keep this custom domain in
  // wrangler so Janus deploys retain the hostname already attached in Cloudflare.
  "routes": [
    {
      "pattern": "mcp.kingminos.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "KINGMINOS_API_URL": "https://api.kingminos.com",
    "KINGMINOS_MCP_PUBLIC_URL": "https://mcp.kingminos.com/mcp",
    // MCP OAuth (kingminos-application docs/mcp-oauth-design.md §14). Stays "off"
    // in prod until the API's KingMinosGateway is deployed and the AUTH_SERVER
    // service binding is added here; Harris flips it.
    "OAUTH_ENABLED": "off",
    // Result card for connected apps (src/result-card.ts). Only applies to
    // OAuth callers; "on" to show it.
    "MCP_RESULT_CARDS": "off"
  },
  // Staging pair for MCP OAuth end-to-end (design §14.9). Deploy with
  // `wrangler deploy --env staging` after kingminos-api-staging is live.
  "env": {
    "staging": {
      "name": "kingminos-mcp-staging",
      "routes": [
        {
          "pattern": "mcp-staging.kingminos.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "KINGMINOS_API_URL": "https://api-staging.kingminos.com",
        "KINGMINOS_MCP_PUBLIC_URL": "https://mcp-staging.kingminos.com/mcp",
        "OAUTH_ENABLED": "off",
        "OAUTH_ISSUER": "https://api-staging.kingminos.com",
        "MCP_RESULT_CARDS": "off"
      },
      "services": [
        {
          "binding": "AUTH_SERVER",
          "service": "kingminos-api-staging",
          "entrypoint": "KingMinosGateway"
        }
      ]
    }
  }
}
